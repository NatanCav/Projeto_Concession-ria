# =========================================================
# Copie este arquivo para ".env" e ajuste os valores.
# Nunca versionar o ".env" real (já está no .gitignore).
# =========================================================

# ---- PostgreSQL (usado pelo docker-compose e pelo backend) ----
POSTGRES_DB=concessionaria
POSTGRES_USER=concessionaria
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# String de conexão JDBC usada pelo Spring Boot
DATABASE_URL=jdbc:postgresql://localhost:5432/concessionaria
DATABASE_USERNAME=concessionaria
DATABASE_PASSWORD=change-me

# ---- Autenticação / JWT ----
# Gere um valor aleatório forte (ex.: openssl rand -base64 48)
JWT_SECRET=change-me-to-a-long-random-base64-secret
JWT_EXPIRATION_MS=28800000

# ---- Usuário administrador de desenvolvimento ----
# Usado apenas pelo seeder do profile "dev" (backend/.../DataSeeder.java).
# Nunca é lido em produção.
APP_ADMIN_NAME=Administrador
APP_ADMIN_EMAIL=admin@concessionaria.dev
APP_ADMIN_PASSWORD=change-me-strong-password

# ---- Backend ----
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
CORS_ALLOWED_ORIGINS=http://localhost:5173
FILE_STORAGE_LOCATION=./uploads

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8080/api
